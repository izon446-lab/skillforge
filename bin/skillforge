#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
usage() { echo "usage: skillforge new <slug> \"description...\"" >&2; exit 2; }
[ "${1:-}" = "new" ] || usage
SLUG="${2:-}"; DESC="${3:-}"
[ -n "$SLUG" ] && [ -n "$DESC" ] || usage
[[ "$SLUG" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "slug must be kebab-case" >&2; exit 2; }
OUT="${SKILLFORGE_OUT:-.}/$SLUG"
[ -e "$OUT" ] && { echo "$OUT already exists" >&2; exit 1; }
mkdir -p "$OUT/references" "$OUT/examples"
: > "$OUT/references/.gitkeep"
SLUG="$SLUG" DESC="$DESC" python3 - "$ROOT/templates/SKILL.md.tmpl" > "$OUT/SKILL.md" <<'PY'
import os,sys
t=open(sys.argv[1]).read()
print(t.replace("{{SLUG}}",os.environ["SLUG"]).replace("{{DESCRIPTION}}",os.environ["DESC"]),end="")
PY
cat > "$OUT/examples/demo-run.md" <<EOF
# Demo run: $SLUG

**User:** TODO example request

**Agent (using $SLUG):** TODO example response
EOF
cat > "$OUT/README.md" <<EOF
# $SLUG

$DESC

Generated by [skillforge](https://github.com/izon446-lab/skillforge).
EOF
echo "created $OUT"
